<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>ForeverLauncher</AssemblyName>
    <GenerateAssemblyInfo>False</GenerateAssemblyInfo>
    <OutputType>WinExe</OutputType>
    <UseWPF>True</UseWPF>
    <UseWindowsForms>True</UseWindowsForms>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
  </PropertyGroup>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
    <CheckForOverflowUnderflow>False</CheckForOverflowUnderflow>
  </PropertyGroup>
  <PropertyGroup>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <RootNamespace />
  </PropertyGroup>
  <ItemGroup>
    <None Remove="ForeverLauncher.MainWindow.xaml" />
    <None Remove="Addon.ForeverRecap.ForeverRecap.toc" />
    <None Remove="Addon.ForeverRecap.ForeverRecap.lua" />
    <EmbeddedResource Include="ForeverLauncher.MainWindow.xaml" LogicalName="ForeverLauncher.MainWindow.xaml" />
    <EmbeddedResource Include="Addon.ForeverRecap.ForeverRecap.toc" LogicalName="Addon.ForeverRecap.ForeverRecap.toc" />
    <EmbeddedResource Include="Addon.ForeverRecap.ForeverRecap.lua" LogicalName="Addon.ForeverRecap.ForeverRecap.lua" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="System.Core" />
    <Reference Include="System.Web" />
    <Reference Include="System.Web.Extensions" />
  </ItemGroup>
</Project>

